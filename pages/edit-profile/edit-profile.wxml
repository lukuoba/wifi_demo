<!-- pages/edit-profile/edit-profile.wxml -->
<view class="container">
  <view class="form-section">
    <!-- 头像部分 -->
    <view class="form-item avatar-item">
      <text class="label">头像</text>
      <view class="avatar-content">
        <image class="current-avatar" src="{{avatarUrl || '/static/icons/default-avatar.png'}}" mode="aspectFill"></image>
        <view class="btn-group">
          <button class="btn-wechat" bindtap="getWechatUserInfo">获取微信头像</button>
          <button class="btn-choose" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">选择头像</button>
        </view>
      </view>
    </view>

    <!-- 昵称部分 -->
    <view class="form-item nickname-item">
      <text class="label">昵称</text>
      <input 
        class="nickname-input" 
        type="nickname" 
        value="{{nickname}}" 
        placeholder="请输入昵称" 
        bindinput="onNicknameInput"
      />
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="footer">
    <button class="save-btn {{canSave ? 'active' : ''}}" bindtap="onSave">{{mode === 'register' ? '完 成' : '保 存'}}</button>
  </view>
</view>
