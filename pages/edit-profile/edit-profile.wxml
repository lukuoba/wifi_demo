<!-- pages/edit-profile/edit-profile.wxml -->
<view class="container">
  <view class="form-section">
    <!-- 头像部分 -->
    <view class="form-item avatar-item">
      <text class="label">头像</text>
      <view class="avatar-content">
        <image class="current-avatar" src="{{avatarUrl || '/static/icons/default-avatar.png'}}" mode="aspectFill"></image>
        <view class="btn-group">
          <button class="btn-choose" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">选择头像</button>
        </view>
      </view>
    </view>

    <!-- 昵称部分 -->
    <view class="form-item nickname-item">
      <text class="label">昵称<text style="color:red">*</text></text>
      <input 
        class="nickname-input" 
        type="nickname" 
        value="{{nickname}}" 
        placeholder="请输入昵称（必填）" 
        bindinput="onNicknameInput"
      />
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="footer">
    <button class="save-btn {{canSave && (mode === 'edit' || isAgreed) ? 'active' : ''}}" bindtap="onSave">{{mode === 'register' ? '注 册' : '保 存'}}</button>
    
    <!-- 协议勾选 -->
    <view class="protocol-section" wx:if="{{mode === 'register'}}">
      <checkbox-group bindchange="onAgreeChange">
        <label class="protocol-label">
          <checkbox value="agreed" checked="{{isAgreed}}" color="#52c41a" scale="0.7" />
          <text class="protocol-text">我已阅读并同意</text>
        </label>
      </checkbox-group>
      <text class="protocol-link" bindtap="goToUserAgreement">《用户使用协议》</text>
      <text class="protocol-text">和</text>
      <text class="protocol-link" bindtap="goToPrivacyPolicy">《隐私协议》</text>
    </view>
  </view>
</view>
