/* pages/edit-profile/edit-profile.wxss */
.container {
  background-color: #f8f8f8;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.form-section {
  background-color: #fff;
  padding: 0 30rpx;
  margin-top: 20rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 40rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 32rpx;
  color: #333;
  width: 120rpx;
  font-weight: bold;
}

/* 头像部分样式 */
.avatar-item {
  align-items: flex-start;
}

.avatar-content {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.current-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
  border: 1rpx solid #eee;
}

.btn-group {
  display: flex;
  gap: 20rpx;
}

.btn-choose {
  margin: 0;
  padding: 0 24rpx;
  height: 70rpx;
  line-height: 70rpx;
  font-size: 26rpx;
  border-radius: 8rpx;
}

.btn-choose {
  background-color: #fff;
  color: #52c41a;
  border: 1rpx solid #52c41a;
}

.btn-choose::after {
  border: none;
}

/* 昵称部分样式 */
.nickname-item {
  align-items: center;
}

.nickname-input {
  flex: 1;
  height: 80rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  color: #333;
}

/* 底部按钮 */
.footer {
  flex: 1;
  padding: 60rpx 40rpx;
  background-color: #f8f8f8;
}

.save-btn {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  background-color: #e0e0e0;
  color: #999;
  font-size: 34rpx;
  border-radius: 12rpx;
  font-weight: bold;
}

.save-btn.active {
  background-color: #52c41a;
  color: #fff;
}

.save-btn::after {
  border: none;
}

/* 协议部分样式 */
.protocol-section {
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
}

.protocol-label {
  display: flex;
  align-items: center;
}

.protocol-text {
  font-size: 24rpx;
  color: #999;
}

.protocol-link {
  font-size: 24rpx;
  color: #52c41a;
}

/* 缩小勾选框 */
checkbox .wx-checkbox-input {
  width: 30rpx;
  height: 30rpx;
}
