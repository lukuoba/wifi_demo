/* pages/game-detail/game-detail.wxss */
page {
  background-color: #f6f8f7;
}

.page-container {
  min-height: 100vh;
  background-color: #f6f8f7;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Hiragino Sans GB", sans-serif;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* 吸顶容器 */
.sticky-top {
  position: sticky;
  top: 0;
  z-index: 50;
  background-color: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(12rpx);
  border-bottom: 2rpx solid rgba(226, 232, 240, 0.8);
}

/* 自定义导航 */
.custom-nav {
  position: relative;
}

.nav-inner {
  height: 100%;
  position: relative;
  display: flex;
  align-items: center;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -8rpx;
}

.nav-center {
  position: absolute;
  left: 80rpx;
  right: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  letter-spacing: 1rpx;
}

/* 4 格快捷操作 */
.quick-actions {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 28rpx 24rpx;
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 8rpx;
  background-color: rgba(248, 250, 252, 0.9);
  border-radius: 20rpx;
  transition: transform 0.15s ease;
}

.quick-item:active {
  transform: scale(0.95);
}

.quick-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
  box-shadow: 0 2rpx 6rpx rgba(15, 23, 42, 0.04);
}

.icon-emerald {
  background-color: #ecfdf5;
}

.icon-blue {
  background-color: #eff6ff;
}

.icon-slate {
  background-color: #f1f5f9;
}

.icon-table {
  background-color: #f1f5f9;
  padding: 0;
}

.switch {
  position: relative;
  width: 80rpx;
  height: 40rpx;
  background-color: #e2e8f0;
  border-radius: 999rpx;
  transition: all 0.2s ease;
  box-shadow: inset 0 2rpx 4rpx rgba(15, 23, 42, 0.08);
}

.switch.on {
  background-color: #059669;
}

.switch-dot {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background-color: #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(15, 23, 42, 0.15);
  transition: left 0.2s ease;
}

.switch.on .switch-dot {
  left: 44rpx;
}

.quick-label {
  font-size: 22rpx;
  font-weight: 500;
  color: #334155;
  letter-spacing: 1rpx;
}

/* 主内容 */
.main-content {
  padding: 20rpx 28rpx 0;
}

.player-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 玩家卡片 */
.player-card {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  background-color: #ffffff;
  border: 2rpx solid rgba(241, 245, 249, 0.9);
  border-radius: 32rpx;
  box-shadow: 0 4rpx 20rpx -2rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.card-press {
  transform: scale(0.995);
}

.player-card.is-winner {
  background: linear-gradient(90deg, #ffffff 0%, rgba(254, 242, 242, 0.4) 50%, rgba(255, 251, 235, 0.35) 100%);
  border-color: rgba(251, 113, 133, 0.3);
}

.winner-accent {
  position: absolute;
  top: -48rpx;
  right: -48rpx;
  width: 220rpx;
  height: 220rpx;
  background-color: rgba(244, 63, 94, 0.1);
  border-radius: 50%;
  filter: blur(20rpx);
  pointer-events: none;
}

.player-info {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.avatar-img,
.avatar-fallback {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background-color: #e2e8f0;
  box-shadow: 0 2rpx 6rpx rgba(15, 23, 42, 0.05);
}

.avatar-img {
  display: block;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
  border: 2rpx solid rgba(226, 232, 240, 0.8);
  box-sizing: border-box;
}

.avatar-ring-winner {
  box-shadow: 0 0 0 4rpx rgba(251, 113, 133, 0.3);
  border-color: rgba(251, 113, 133, 0.4);
}

.winner-badge {
  position: absolute;
  right: -8rpx;
  bottom: -12rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background-color: #dc2626;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 24rpx;
  box-shadow: 0 2rpx 6rpx rgba(220, 38, 38, 0.25);
}

.owner-badge {
  position: absolute;
  left: -6rpx;
  bottom: -10rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background-color: #f59e0b;
  border: 2rpx solid #ffffff;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 24rpx;
}

.player-meta {
  min-width: 0;
  flex: 1;
}

.player-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.player-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.owner-tag {
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  background-color: #fef3c7;
  color: #b45309;
  font-size: 18rpx;
  font-weight: 600;
}

.player-score-row {
  margin-top: 6rpx;
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  white-space: nowrap;
}

.score-label {
  font-size: 22rpx;
  font-weight: 500;
}

.score-label.is-win {
  color: #f43f5e;
}

.score-label.is-loss {
  color: #94a3b8;
}

.score-value {
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: -0.5rpx;
}

.score-value.is-win {
  color: #e11d48;
}

.score-value.is-loss {
  color: #334155;
  font-weight: 700;
  font-size: 38rpx;
}

/* 给分按钮 */
.player-actions {
  flex-shrink: 0;
}

.give-btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 0 36rpx;
  height: 68rpx;
  background-color: #059669;
  color: #ffffff;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 10rpx rgba(5, 150, 105, 0.2);
  transition: all 0.15s ease;
}

.give-btn:active {
  transform: scale(0.95);
  background-color: #047857;
}

.give-plus {
  position: relative;
  width: 22rpx;
  height: 22rpx;
}

.give-plus::before,
.give-plus::after {
  content: "";
  position: absolute;
  background-color: #ffffff;
  border-radius: 2rpx;
}

.give-plus::before {
  top: 50%;
  left: 0;
  width: 100%;
  height: 4rpx;
  transform: translateY(-50%);
}

.give-plus::after {
  left: 50%;
  top: 0;
  width: 4rpx;
  height: 100%;
  transform: translateX(-50%);
}

/* 空状态 */
.empty-state {
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-icon {
  width: 140rpx;
  height: 140rpx;
  margin: 0 auto 24rpx;
  border-radius: 32rpx;
  background-color: #ecfdf5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #334155;
  margin-bottom: 8rpx;
}

.empty-desc {
  display: block;
  font-size: 24rpx;
  color: #94a3b8;
}

/* 底栏占位 */
.bottom-toolbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 140rpx;
  background-color: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(12rpx);
  border-top: 2rpx solid rgba(226, 232, 240, 0.7);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 40;
}

/* 给分弹窗 */
.score-modal-wrap {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.score-modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(15, 23, 42, 0.45);
}

.score-modal {
  position: relative;
  width: 100%;
  background-color: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.score-modal-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 32rpx;
}

.quick-score-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.quick-score-btn {
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.quick-score-btn.is-minus {
  background-color: #fef2f2;
  color: #dc2626;
}

.quick-score-btn.is-plus {
  background-color: #ecfdf5;
  color: #047857;
}

.score-preview {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background-color: #f8fafc;
  margin-bottom: 24rpx;
}

.score-preview-label {
  font-size: 24rpx;
  color: #64748b;
}

.score-preview-value {
  font-size: 40rpx;
  font-weight: 800;
  font-family: "SF Mono", Menlo, Consolas, monospace;
}

.score-preview-value.is-plus {
  color: #dc2626;
}

.score-preview-value.is-minus {
  color: #334155;
}

.score-input-wrap {
  margin-bottom: 32rpx;
}

.score-input {
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 28rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 20rpx;
  background-color: #f8fafc;
  font-size: 32rpx;
  color: #0f172a;
  text-align: center;
  box-sizing: border-box;
}

.score-input-placeholder {
  color: #94a3b8;
}

.score-modal-btns {
  display: flex;
  gap: 20rpx;
}

.score-modal-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
  padding: 0;
  border: none;
}

.score-modal-btn::after {
  border: none;
}

.score-modal-btn.cancel {
  background-color: #f1f5f9;
  color: #475569;
}

.score-modal-btn.confirm {
  background: linear-gradient(90deg, #059669 0%, #10b981 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(5, 150, 105, 0.25);
}
