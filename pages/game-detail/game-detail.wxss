/* pages/game-detail/game-detail.wxss */
.container {
  background-color: #f8f8f8;
  min-height: 100vh;
}

/* 顶部操作栏 */
.action-bar {
  background-color: #fff;
  display: flex;
  justify-content: space-around;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.action-name {
  font-size: 24rpx;
  color: #666;
}

/* 玩家列表 */
.player-list {
  padding: 20rpx;
}

.player-card {
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.player-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-container {
  position: relative;
  width: 100rpx;
  height: 100rpx;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-text {
  font-size: 40rpx;
  color: #fff;
  font-weight: bold;
}

.owner-tag {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  z-index: 1;
}

.player-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.player-name {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.player-score-info {
  display: flex;
  align-items: baseline;
}

.score-type {
  font-size: 26rpx;
  color: #666;
}

.score-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff4d4f; /* 图片中的红色分数 */
}

/* 按钮样式 */
.give-btn {
  background-color: #52c41a;
  color: #fff;
  font-size: 28rpx;
  padding: 0 40rpx;
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 8rpx;
  margin: 0;
}

.give-btn::after {
  border: none;
}
