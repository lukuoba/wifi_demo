<!-- pages/game-detail/game-detail.wxml -->
<view class="page-container">

  <!-- 吸顶导航 + 快捷操作 -->
  <view class="sticky-top">
    <!-- 顶部导航 -->
    <view class="custom-nav" style="padding-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
      <view class="nav-inner">
        <view class="nav-back" bindtap="onBackTap">
          <icon name="guanbianniu-copy" size="{{20}}" color="#1e293b" />
        </view>
        <view class="nav-center">
          <text class="nav-title">{{gameTitle}}</text>
        </view>
        <!-- 右上角邀请：点击再次唤起二维码弹窗 -->
        <view class="nav-invite" bindtap="onInvite">
          <icon name="duoren" size="{{16}}" color="#059669" />
          <text class="nav-invite-text">邀请</text>
        </view>
      </view>
    </view>

    <!-- 4 格快捷操作 -->
    <view class="quick-actions">
      <view class="quick-item" bindtap="onActionTap" data-id="invite">
        <view class="quick-icon icon-emerald">
          <icon name="duoren" size="{{18}}" color="#059669" />
        </view>
        <text class="quick-label">邀请</text>
      </view>
      <view class="quick-item" bindtap="onActionTap" data-id="detail">
        <view class="quick-icon icon-blue">
          <icon name="mark-pen-line" size="{{18}}" color="#2563eb" />
        </view>
        <text class="quick-label">明细</text>
      </view>
      <view class="quick-item" bindtap="onActionTap" data-id="rules">
        <view class="quick-icon icon-slate">
          <icon name="shanchuanniu" size="{{18}}" color="#475569" />
        </view>
        <text class="quick-label">规则</text>
      </view>
      <view class="quick-item" bindtap="onToggleTableMode">
        <view class="quick-icon icon-table">
          <view class="switch {{tableMode ? 'on' : ''}}">
            <view class="switch-dot"></view>
          </view>
        </view>
        <text class="quick-label">台板</text>
      </view>
    </view>
  </view>

  <!-- 主内容：玩家列表 -->
  <view class="main-content">

    <view class="player-list">
      <view
        wx:for="{{players}}"
        wx:key="id"
        class="player-card {{item.isWinner ? 'is-winner' : ''}}"
        hover-class="card-press"
      >
        <view wx:if="{{item.isWinner}}" class="winner-accent"></view>

        <view class="player-info">
          <view class="avatar-wrap">
            <image wx:if="{{item.avatar}}" class="avatar-img {{item.isWinner ? 'avatar-ring-winner' : ''}}" src="{{item.avatar}}" mode="aspectFill"></image>
            <view wx:else class="avatar-fallback {{item.isWinner ? 'avatar-ring-winner' : ''}}" style="background: {{item.avatarColor}};">
              {{item.avatarText}}
            </view>
            <view wx:if="{{item.isWinner}}" class="winner-badge">手气正旺</view>
            <view wx:elif="{{item.isOwner}}" class="owner-badge">房主</view>
          </view>

          <view class="player-meta">
            <view class="player-name-row">
              <text class="player-name">{{item.name}}</text>
              <text wx:if="{{item.isOwner}}" class="owner-tag">房主</text>
            </view>
            <view class="player-score-row">
              <text class="score-label {{item.isPositive ? 'is-win' : 'is-loss'}}">{{item.isPositive ? '赢' : '输'}}:</text>
              <text class="score-value {{item.isPositive ? 'is-win' : 'is-loss'}}">{{item.scoreText}}</text>
            </view>
          </view>
        </view>

        <view class="player-actions">
          <view
            class="give-btn"
            data-index="{{index}}"
            bindtap="giveScore"
            catchtap="giveScore"
          >
            <view class="give-plus"></view>
            <text>给分</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{!players.length}}" class="empty-state">
      <view class="empty-icon">
        <icon name="duoren" size="{{40}}" color="#10b981" />
      </view>
      <text class="empty-title">还没有玩家加入</text>
      <text class="empty-desc">点击「邀请」让牌友扫码加入</text>
    </view>

  </view>

  <!-- 固定底栏（给分快捷面板预留区域，暂无按钮） -->
  <view class="bottom-toolbar"></view>

  <!-- 邀请二维码弹窗 -->
  <view wx:if="{{showQrModal}}" class="qr-modal-wrap">
    <view class="qr-modal-mask" bindtap="onCloseQrModal"></view>
    <view class="qr-modal">
      <view class="qr-modal-close" bindtap="onCloseQrModal">
        <icon name="guanbianniu-copy" size="{{18}}" color="#94a3b8" />
      </view>

      <text class="qr-modal-title">邀请牌友</text>
      <text class="qr-modal-subtitle">{{gameTitle}} · 房间 {{gameId}}</text>

      <view class="qr-canvas-card">
        <!-- 后端小程序码：微信扫一扫直接打开小程序进对局 -->
        <image wx:if="{{wxacodeImage}}" class="qr-image" src="{{wxacodeImage}}" mode="aspectFit"></image>
        <!-- 本地链接二维码兜底 -->
        <canvas wx:else type="2d" id="qrCanvas" class="qr-canvas"></canvas>
      </view>

      <text class="qr-modal-hint">牌友扫描二维码加入本局</text>
      <text class="qr-modal-hint-sub">也可以转发给微信好友，点击卡片直达</text>

      <button class="qr-share-btn" open-type="share">
        <text>转发给微信好友</text>
      </button>
    </view>
  </view>

  <!-- 给分弹窗 -->
  <view wx:if="{{showScoreModal}}" class="score-modal-wrap">
    <view class="score-modal-mask" bindtap="onCancelScore"></view>
    <view class="score-modal">
      <view class="score-modal-title">
        <text>给 {{scoreTarget.name}} 记分</text>
      </view>

      <!-- 快捷加减 -->
      <view class="quick-score-row">
        <view wx:for="{{quickScores}}" wx:key="*this" class="quick-score-btn is-minus" bindtap="onQuickScore" data-value="{{-item}}">-{{item}}</view>
        <view wx:for="{{quickScores}}" wx:key="*this" class="quick-score-btn is-plus" bindtap="onQuickScore" data-value="{{item}}">+{{item}}</view>
      </view>

      <!-- 当前变更值 -->
      <view class="score-preview">
        <text class="score-preview-label">本次变更</text>
        <text class="score-preview-value {{scoreDelta > 0 ? 'is-plus' : 'is-minus'}}">{{scoreDelta > 0 ? '+' : ''}}{{scoreDelta}}</text>
      </view>

      <!-- 手动输入 -->
      <view class="score-input-wrap">
        <input
          class="score-input"
          type="digit"
          value="{{scoreDelta}}"
          bindinput="onScoreInput"
          placeholder="输入分数"
          placeholder-class="score-input-placeholder"
        />
      </view>

      <view class="score-modal-btns">
        <button class="score-modal-btn cancel" bindtap="onCancelScore">取消</button>
        <button class="score-modal-btn confirm" bindtap="onConfirmScore">确认给分</button>
      </view>
    </view>
  </view>
</view>
