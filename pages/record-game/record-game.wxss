/* pages/record-game/record-game.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 顶部吸顶筛选模块 */
.sticky-header {
  position: sticky;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #ffffff;
  padding: 20rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #eeeeee;
}

.filter-tabs {
  display: flex;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 4rpx;
  border: 1rpx solid #52c41a;
}

.tab-item {
  padding: 10rpx 24rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 6rpx;
}

.tab-item.active {
  background-color: #52c41a;
  color: #ffffff;
}

.header-btns {
  display: flex;
  gap: 16rpx;
}

.btn-item {
  border: 1rpx solid #ddd;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
  display: flex;
  align-items: center;
}

.icon-btn {
  padding: 10rpx 12rpx;
}

/* 统计摘要卡片 */
.summary-card {
  background-color: #ffffff;
  margin: 20rpx;
  border-radius: 12rpx;
  padding: 24rpx;
}

.summary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.summary-info {
  font-size: 24rpx;
  color: #999;
}

.rank-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.rank-link text {
  font-size: 24rpx;
  color: #52c41a;
}

.summary-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.summary-row {
  display: flex;
}

.summary-item {
  flex: 1;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.summary-item .label {
  font-size: 24rpx;
  color: #666;
  width: 60rpx;
}

.summary-item .value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 对局列表 */
.game-list {
  padding: 0 0rpx; /* play-game 组件自带 margin */
}
