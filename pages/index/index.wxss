/* 主页面 */
.page-container {
  background-color: #fff;
  min-height: 100vh;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 顶部栏 */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.title-left {
  display: flex;
  align-items: center;
}

.avatar {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.title {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.title-right {
  display: flex;
  align-items: center;
}

.new-game {
  color: #ff3a3a;
  font-size: 28rpx;
  margin-right: 20rpx;
}

.bell {
  width: 40rpx;
  height: 40rpx;
}

/* 2×2 卡片 */
.grid-box {
  display: flex;
  flex-wrap: wrap;
  gap: 32rpx;
  margin-bottom: 40rpx;
}

.card-item {
  width: calc((100% - 32rpx) / 2);
  box-sizing: border-box;
  background: rgba(42, 33, 42, 0.7);
  border-radius: 24rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 0 12rpx rgba(255,255,255,0.05);
}

.icon {
  font-size: 44rpx;
  margin-bottom: 16rpx;
}

.red { color: #ff4747; }
.blue { color: #4285f4; }
.gold { color: #f9b950; }
.green { color: #50fa7b; }

.card-text {
  color: #f0f0f0;
  font-size: 26rpx;
}

/* 计分卡片 */
.score-card {
  background: #1e1e1e;
  border-radius: 28rpx;
  padding: 36rpx;
  margin-bottom: 40rpx;
}

.score-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.score-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
}

.score-status {
  color: #ff3a3a;
  font-size: 24rpx;
}

/* 玩家列表 */
.player-item {
  display: flex;
  justify-content: space-between;
}

.name {
  color: #e0e0e0;
  font-size: 28rpx;
}

.score {
  font-size: 30rpx;
  font-weight: bold;
}

.plus { color: #50fa7b; }
.minus { color: #ff5555; }

/* 按钮 */
.action-box {
  margin-top: 30rpx;
  display: flex;
  justify-content: center;
}

.record-btn {
  background-color: #ff3a3a;
  color: #fff;
  padding: 24rpx 60rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
}

/* 广告位 */
.ad-container {
  background: #1e1e1e;
  border-radius: 20rpx;
  padding: 20rpx;
  text-align: center;
}

.ad-label {
  color: #888;
  font-size: 22rpx;
  margin-bottom: 10rpx;
}

.ad-content {
  color: #ccc;
  font-size: 24rpx;
  padding: 30rpx 0;
}

/* Tag Selection Modal */
.tag-modal-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.tag-modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.6);
}

.tag-modal-content {
  background-color: #fff;
  border-radius: 16rpx;
  width: 80%;
  max-width: 600rpx;
  padding: 40rpx;
  box-sizing: border-box;
  position: relative;
  z-index: 1001;
  display: flex;
  flex-direction: column;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
  color: #333;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 40rpx;
  justify-content: center;
}

.tag-item {
  padding: 16rpx 28rpx;
  border: 2rpx solid #ccc;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #666;
  background-color: #f0f0f0;
  transition: all 0.2s;
}

.selected {
  background-color: #52c41a;
  color: #fff;
  border-color: #52c41a;
}

.modal-buttons {
  display: flex;
  justify-content: space-around;
  width: 100%;
}

.modal-btn {
  flex: 1;
  margin: 0 10rpx;
  padding: 15rpx 0;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
  text-align: center;
  border: none;
}

.cancel-btn {
  background-color: #e0e0e0;
  color: #666;
}

.confirm-btn {
  background-color: #52c41a;
  color: #fff;
}
