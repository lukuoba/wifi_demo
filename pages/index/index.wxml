<!-- 主容器 -->
<view class="page-container">

<!-- 2×2 功能卡片 -->
<view class="grid-box">
  <view class="card-item" wx:for="{{selectCard}}"  wx:key="index"  data-name="{{item}}" bindtap="selectCard">
    <icon name="{{item.icon}}" size="{{40}}" color="#fff"/>
    <text class="card-text">{{item.name}}</text>
  </view>
</view>

<!-- 中间：当前计分卡片 -->
<play-game players="{{currentGame.players}}" currentMode="{{currentMode}}" />

<!-- 底部广告位 -->
<view class="ad-container">
  <view class="ad-label">赞助内容</view>
  <view class="ad-content">
    <text>观看视频广告解锁高级功能</text>
  </view>
</view>

<navigation-bar active="home" />

<!-- 标签选择弹窗 -->
<view class="tag-modal-container" wx:if="{{showTagModal}}">
  <view class="tag-modal-mask" bindtap="onCancelTagSelection"></view>
  <view class="tag-modal-content">
    <view class="modal-title">可选标签进行开局</view>
    <view class="tag-list">
      <view
        wx:for="{{tags}}"
        wx:key="id"
        class="tag-item {{selectedTags == item.id ? 'selected' : ''}}"
        bindtap="onTagTap"
        data-id="{{item.id}}"
      >
        {{item.name}}
      </view>
    </view>
    <view class="modal-buttons">
      <button class="modal-btn cancel-btn" bindtap="onCancelTagSelection">取消</button>
      <button class="modal-btn confirm-btn" bindtap="onConfirmTagSelection">立即开局</button>
    </view>
  </view>
</view>

</view>