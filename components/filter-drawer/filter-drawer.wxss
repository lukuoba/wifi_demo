/* components/filter-drawer/filter-drawer.wxss */
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: none;
  z-index: 1000;
}

.drawer-mask.show {
  display: block;
}

.drawer-container {
  position: fixed;
  top: 0;
  right: -80%;
  width: 80%;
  height: 100%;
  background: #fff;
  z-index: 1001;
  transition: right 0.3s ease;
  display: flex;
  flex-direction: column;
}

.drawer-container.show {
  right: 0;
}

.drawer-content {
  flex: 1;
  overflow-y: auto;
  padding: 40rpx 30rpx;
}

.section {
  margin-bottom: 50rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

/* 日期选择样式 */
.date-picker-group {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.date-input {
  width: 240rpx;
  height: 70rpx;
  line-height: 70rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  text-align: center;
  font-size: 26rpx;
  color: #333;
}

.date-input.placeholder {
  color: #999;
}

.date-separator {
  color: #999;
  font-size: 26rpx;
}

.quick-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.quick-btn {
  width: 130rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
  border: 1rpx solid transparent;
}

.quick-btn.active {
  border-color: #52c41a;
  color: #52c41a;
  background: #f6ffed;
}

.clear-btn {
  border-color: #ff4d4f;
  color: #ff4d4f;
  background: #fff;
}

/* 标签组样式 */
.tab-group {
  display: flex;
  border: 1rpx solid #52c41a;
  border-radius: 8rpx;
  overflow: hidden;
  width: fit-content;
}

.tab-item {
  padding: 12rpx 30rpx;
  font-size: 26rpx;
  color: #52c41a;
  border-right: 1rpx solid #52c41a;
}

.tab-item:last-child {
  border-right: none;
}

.tab-item.active {
  background: #52c41a;
  color: #fff;
}

.label-empty {
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
}

/* 底部按钮 */
.drawer-footer {
  padding: 30rpx;
  display: flex;
  gap: 20rpx;
  border-top: 1rpx solid #eee;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
}

.footer-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  border-radius: 12rpx;
}

.reset-btn {
  background: #fff;
  color: #666;
  border: 1rpx solid #ddd;
}

.confirm-btn {
  background: #52c41a;
  color: #fff;
}
