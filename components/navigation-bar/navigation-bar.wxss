/* components/navigation-bar/navigation-bar.wxss */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: #ffffff;
  display: flex;
  justify-content: space-around;
  align-items: center;
  border-top: 1rpx solid #eeeeee;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
}

.icon-wrapper {
  margin-bottom: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-text {
  font-size: 24rpx;
  color: #999999;
}

/* 选中态样式 */
.tab-item.active .tab-text {
  color: #52c41a; /* 图片中的绿色主题色 */
}

/* 占位元素 */
.tab-bar-placeholder {
  height: calc(110rpx + env(safe-area-inset-bottom));
  width: 100%;
}
