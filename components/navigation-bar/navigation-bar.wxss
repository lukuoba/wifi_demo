/* components/navigation-bar/navigation-bar.wxss */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: rgba(255, 255, 255, 0.94);
  display: flex;
  justify-content: space-around;
  align-items: center;
  border-top: 1rpx solid #f1f5f9;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-item-bottom-bar {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
}

.icon-wrapper {
  margin-bottom: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-text {
  font-size: 24rpx;
  color: #94a3b8;
}

/* 选中态样式 */
.tab-item-bottom-bar.active .tab-text {
  color: #059669;
}

/* 占位元素 */
.tab-bar-placeholder {
  height: calc(110rpx + env(safe-area-inset-bottom));
  width: 100%;
}
