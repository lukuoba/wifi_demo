<!-- components/navigation-bar/navigation-bar.wxml -->
<view class="tab-bar">
  <view 
    wx:for="{{navItems}}" 
    wx:key="id" 
    class="tab-item {{active === item.id ? 'active' : ''}}"
    bindtap="switchNav"
    data-id="{{item.id}}"
    data-path="{{item.path}}"
  >
    <view class="icon-wrapper">
      <icon 
        name="{{item.icon}}" 
        size="{{24}}" 
        color="{{active === item.id ? '#52c41a' : '#999'}}" 
      />
    </view>
    <text class="tab-text">{{item.name}}</text>
  </view>
</view>

<!-- 占位元素，防止底部内容被遮挡 -->
<view class="tab-bar-placeholder"></view>
