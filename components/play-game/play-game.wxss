/* components/play-game/play-game.wxss */
.game-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

/* 头部样式 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.header-left {
  display: flex;
  align-items: center;
}

.game-title {
  font-size: 32rpx;
  color: #666;
  margin-right: 30rpx;
}

.game-status {
  font-size: 32rpx;
  color: #4cd964;
}

.header-actions {
  display: flex;
}

.action-icon {
  width: 60rpx;
  height: 60rpx;
  border: 1rpx solid #eee;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
}

/* 玩家列表样式 */
.player-grid {
  display: flex;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.player-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
}

.avatar-container {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 16rpx;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  background: #f5f5f5;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-text {
  font-size: 40rpx;
  color: #fff;
  background: #4cd964;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.owner-tag {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  z-index: 1;
}

.player-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 8rpx;
  width: 100%;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.player-score {
  font-size: 32rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.player-score.negative {
  color: #333;
}

/* 底部时间样式 */
.card-footer {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.time-info {
  font-size: 24rpx;
  color: #999;
}
